# ไม่นำ Git metadata และไฟล์เฉพาะเครื่องเข้า Docker build context
.git
.gitignore
.venv
venv
env
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.db
*.sqlite3
# ข้อมูล runtime และ ML artifacts ถูก mount เป็น volume จึงไม่ต้องคัดลอกเข้า image
storage/
# ไฟล์ทดลอง monitoring และแผนภาพไม่จำเป็นสำหรับการ build image ของแอป
sandbox/
observability/
diagrams/
docs/
.ruff_cache/

# ตัวแปรระบบตั้งต้นสำหรับการรัน Docker Compose ในโหมด Local Development
# คัดลอกไฟล์นี้เป็น .env: cp .env.example .env (หรือ copy .env.example .env บน Windows)

DATABASE_URL=postgresql://admin:secretpassword@postgres:5432/my_database
REDIS_URL=redis://redis:6379
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=my_database
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123

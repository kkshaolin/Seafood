# ==============================================================================
# Production Environment Variables Template (.env.production)
# ==============================================================================
# คำแนะนำด้านความปลอดภัย:
# 1. คัดลอกไฟล์นี้ไปยัง .env.production หรือ .env บน Production Server:
#      cp .env.production.example .env
# 2. ห้าม commit ไฟล์ .env หรือ .env.production ที่มี credentials จริงลง Git เด็ดขาด
# 3. สร้างรหัสผ่านที่ปลอดภัยด้วยคำสั่ง:
#      openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core & Security
# ------------------------------------------------------------------------------
APP_ENV=production
DEBUG=false
APP_NAME="I_LoveSeafood AI Ecosystem"
# สุ่ม Secret Key สำหรับแอปพลิเคชัน (แนะนำ openssl rand -hex 32)
SECRET_KEY=replace_with_a_secure_random_hex_string_32_bytes_or_more
JWT_SECRET_KEY=replace_with_another_secure_random_hex_string_for_jwt

# พอร์ตบน loopback สำหรับให้ reverse proxy ที่ติดตั้งบน host ส่งต่อผ่าน HTTPS
FRONTEND_PROD_PORT=8081

# กำหนดโดเมนที่อนุญาตให้เรียก API ผ่าน CORS (ระบุเป็น JSON Array หรือ Comma-separated)
# same-origin frontend calls do not require CORS; add only trusted application origins if needed.
CORS_ORIGINS=["https://stock.example.com"]

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL Production)
# ------------------------------------------------------------------------------
POSTGRES_USER=prod_admin
POSTGRES_PASSWORD=replace_with_very_strong_db_password
POSTGRES_DB=seafood_db
DATABASE_URL=postgresql://prod_admin:replace_with_very_strong_db_password@postgres:5432/seafood_db

# (ทางเลือก) Centralized Snapshot Hub (Supabase Pooler)
SUPABASE_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<SUPABASE_DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 3. Message Queue & Cache (Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 4. Object Storage (MinIO S3 Compatible)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=replace_with_strong_minio_password
MINIO_SECURE=false
MINIO_BUCKET_NAME=ai-ecosystem-data

# ------------------------------------------------------------------------------
# 5. MLOps & Experiment Tracking (MLflow & TensorBoard)
# ------------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
TENSORBOARD_LOG_DIR=/app/storage/logs/tensorboard

# ------------------------------------------------------------------------------
# 6. Observability & Monitoring (Grafana Security)
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=grafana_admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password

# ------------------------------------------------------------------------------
# 7. Model Hub & Data Connectors (Optional / External)
# ------------------------------------------------------------------------------
HF_REPO_ID=kkshaolin/yolo_box
HF_TOKEN=optional_huggingface_write_token_if_needed

LABEL_STUDIO_URL=http://label-studio:8080
LABEL_STUDIO_API_KEY=optional_label_studio_user_token

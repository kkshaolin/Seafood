{
  "compilerOptions": {
    // กำหนดมาตรฐาน JavaScript และ API ของเบราว์เซอร์ที่คอมโพเนนต์ React ใช้งานได้
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["src/*"]
    },

    /* ให้ Vite จัดการ module และ asset ส่วน TypeScript ใช้ตรวจชนิดข้อมูลโดยไม่ปล่อยไฟล์ JS */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* เปิดการตรวจชนิดแบบเข้มงวด แต่ยังไม่บังคับลบตัวแปร/พารามิเตอร์ที่ยังไม่ได้ใช้ระหว่างพัฒนา */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

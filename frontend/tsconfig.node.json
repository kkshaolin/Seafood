{
  "compilerOptions": {
    // แยกการตรวจ TypeScript ของไฟล์ตั้งค่าเครื่องมือที่รันใน Node/Vite ออกจากโค้ดบนเบราว์เซอร์
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts"]
}

# Image แยกสำหรับ data-worker ใน Compose; ใช้ requirements-data และเริ่ม ARQ
# ด้วย data_worker.worker.WorkerSettings บนคิว data_queue
# Stage 1: Builder
FROM python:3.11-slim AS builder

WORKDIR /build

RUN pip install --no-cache-dir uv

COPY requirements-data.txt ./
RUN uv pip install --system --no-cache-dir -r requirements-data.txt

# Stage 2: Production
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 TZ=Asia/Bangkok

RUN useradd -m -u 1000 appuser

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# คัดลอกเฉพาะแพ็กเกจ data worker เพื่อจำกัดขนาด image
COPY data_worker/ ./data_worker/
COPY healthcheck.py ./

RUN chown -R appuser:appuser /app
USER appuser

HEALTHCHECK --interval=60s --timeout=30s --start-period=10s --retries=3 \
    CMD ["python", "/app/healthcheck.py", "data_worker.worker.WorkerSettings"]

CMD ["python", "-m", "arq", "data_worker.worker.WorkerSettings"]
